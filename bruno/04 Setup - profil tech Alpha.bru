meta {
  name: Setup - profil tech Alpha
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/profils
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
  Content-Type: application/json
  Prefer: return=representation
}

body:json {
  {
    "id": "{{userId}}",
    "organisation_id": "{{orgId}}",
    "role": "tech",
    "nom_complet": "Technicien Alpha"
  }
}

tests {
  test("201", function () { expect(res.status).to.equal(201); });
}
