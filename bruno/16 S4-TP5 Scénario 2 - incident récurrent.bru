meta {
  name: S4-TP5 Scénario 2 - incident récurrent
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/tickets
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
  Content-Type: application/json
  Prefer: return=representation
}

body:json {
  {
    "organisation_id": "{{orgId}}",
    "cree_par": "{{userId}}",
    "titre": "Ralentissements importants lors du chargement des factures",
    "description": "Le chargement des factures prend plusieurs minutes depuis ce matin.",
    "priorite": "basse"
  }
}

script:post-response {
  // Mémorise le ticket pour 20 (vérification) et 21 (rejeu vers n8n)
  bru.setEnvVar("ticketId", res.body[0].id);
  bru.setVar("lastTicketRecord", JSON.stringify(res.body[0]));
  bru.setVar("prioritesAttendues", ["haute", "critique"]);
  bru.setVar("escaladeAttendue", null);
  // Attendu : l'historique remonte le ticket critique du scénario 1 => au moins haute
}

tests {
  test("201 statut nouveau", function () {
    expect(res.status).to.equal(201);
    expect(res.body[0].statut).to.equal("nouveau");
  });
}
