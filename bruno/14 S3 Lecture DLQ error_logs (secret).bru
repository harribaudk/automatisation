meta {
  name: S3 Lecture DLQ error_logs (secret)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/error_logs?order=created_at.desc&limit=20&select=created_at,workflow_name,failed_node,error_message,resolved
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
  Content-Type: application/json
  Prefer: return=representation
}
