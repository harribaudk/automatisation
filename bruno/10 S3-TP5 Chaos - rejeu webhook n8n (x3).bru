      "id": "{{chaosTicketId}}",
      "organisation_id": "{{orgId}}",
      "cree_par": "{{userId}}",
      "titre": "Rejeu chaos — panne réseau",
      "description": "Payload forgé",
      "statut": "nouveau",
      "priorite": "haute",
      "metadata": {}
    },
    "old_record": null
  }
}
