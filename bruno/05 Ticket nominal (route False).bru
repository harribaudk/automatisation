meta {
  name: Ticket nominal (route False)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/tickets
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
  Content-Type: application/json
  Prefer: return=representation
}

body:json {
  {
    "organisation_id": "{{orgId}}",
    "cree_par": "{{userId}}",
    "titre": "Demande de nouvel écran",
    "description": "Écran 27 pouces pour le poste 12",
    "priorite": "normale"
  }
}

script:post-response {
  bru.setEnvVar("ticketId", res.body[0].id);
}

tests {
  test("201 statut nouveau", function () {
    expect(res.status).to.equal(201);
    expect(res.body[0].statut).to.equal("nouveau");
  });
}
