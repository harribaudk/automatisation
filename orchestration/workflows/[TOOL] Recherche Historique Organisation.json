    },
    {
      "id": "7470a749-30d1-5840-89d7-29926bca83fa",
      "name": "Agrégation compacte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "// S4 TP3 — Run Once for All Items : HTTP Request a éclaté le tableau en N items.\n// On recompose UNE observation compacte pour l'agent (économie de tokens).\nconst exclude = String($('When Executed by Another Workflow').first().json.exclude_ticket_id ?? '');\nconst incidents = $input.all()\n  .map(i => i.json)\n  .filter(t => t && t.id)              // item vide {} d'Always Output Data / erreur HTTP\n  .filter(t => t.id !== exclude)       // exclusion du ticket courant (côté code : pas de 400 si vide)\n  .slice(0, 5)\n  .map(t => ({ id: t.id, titre: t.titre, priorite: t.priorite, statut: t.statut, cree_le: t.created_at }));\nreturn [{ json: { count: incidents.length, incidents } }];\n"
      }
    }
  ],
