        "url": "=https://klocxsqzinrxnvbwxozx.supabase.co/rest/v1/tickets?select=id,titre,priorite,statut,created_at&organisation_id=eq.{{ encodeURIComponent($('When Executed by Another Workflow').first().json.organisation_id) }}&order=created_at.desc&limit=6",
